    static class BarChart extends JComponent {
        private List<String> labels = new ArrayList<>();
        private List<Integer> vals = new ArrayList<>();
        private final Color accent;

        BarChart(Color accent) { this.accent = accent; }

        void setData(List<String> l, List<Integer> v) {
            labels = l;
            vals = v;
            revalidate();
            repaint();
        }

        @Override
        public Dimension getPreferredSize() {
            return new Dimension(400, Math.max(60, vals.size() * 36));
        }

        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
            if (vals.isEmpty()) {
                g2.setFont(font(P, 14));
                g2.setColor(MUTED);
                g2.drawString("No menu yet. Load the default menu from Setup Menu & Stock.", 4, 24);
                g2.dispose();
                return;
            }
            int max = 1;
            for (int v : vals) max = Math.max(max, v);
            int labelW = 150, valueW = 60, rowH = 36, barH = 16;
            int area = Math.max(60, getWidth() - labelW - valueW);
            for (int i = 0; i < vals.size(); i++) {
                int y = i * rowH, v = vals.get(i);
                int barY = y + (rowH - barH) / 2;
                g2.setFont(font(P, 13));
                g2.setColor(TEXT);
                FontMetrics fm = g2.getFontMetrics();
                int ty = y + (rowH + fm.getAscent() - fm.getDescent()) / 2;
                g2.drawString(labels.get(i), 0, ty);
                g2.setColor(new Color(0xE5E7EB));
                g2.fillRoundRect(labelW, barY, area, barH, barH, barH);
                int bw = (int) (area * (v / (double) max));
                g2.setColor(v <= 5 ? RED : accent);
                g2.fillRoundRect(labelW, barY, Math.max(bw, v > 0 ? barH : 0), barH, barH, barH);
                g2.setColor(v <= 5 ? RED : MUTED);
                g2.setFont(font(B, 13));
                g2.drawString(String.valueOf(v), labelW + area + 12, ty);
            }
            g2.dispose();
        }
    }

