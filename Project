    private static Page staffPending() {
        RoundedButton refresh = new RoundedButton("⟳  Refresh", INDIGO, Color.WHITE);
        Page p = page("Pending Orders", "Orders waiting in the kitchen queue. Updates every 5 seconds.", refresh);

        DefaultTableModel m = model("Token ID", "Student ID", "Status");
