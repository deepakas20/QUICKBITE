                BorderLayout.CENTER);
        RoundedButton load = new RoundedButton("⚙️  Load default menu", INDIGO, Color.WHITE);
        action.add(load, BorderLayout.EAST);

        DefaultTableModel m = model("Item ID", "Item Name", "Price (Rs)", "Stock Available");
        JTable t = table(m, INDIGO);
        JLabel msg = label(" ", B, 13, GREEN);
        Card tableCard = new Card(new BorderLayout(0, 10));
        tableCard.add(msg, BorderLayout.NORTH);
        tableCard.add(scroll(t), BorderLayout.CENTER);

        JPanel body = new JPanel(new BorderLayout(0, 18));
        body.setOpaque(false);
        body.add(action, BorderLayout.NORTH);
        body.add(tableCard, BorderLayout.CENTER);
        p.add(body, BorderLayout.CENTER);

        load.addActionListener(e -> {
            int ok = JOptionPane.showConfirmDialog(null, "This resets the menu, all stock levels, and clears old pending orders. Continue?",
                    "Confirm reset", JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);
            if (ok != JOptionPane.YES_OPTION) return;
            try (Connection conn = db(); Statement stmt = conn.createStatement()) {
                stmt.executeUpdate("DROP TABLE IF EXISTS MenuItems");
                stmt.executeUpdate("CREATE TABLE MenuItems (itemId VARCHAR(10) PRIMARY KEY, name VARCHAR(50), price DOUBLE, stock INT)");

                // Clear old orders so pending order list becomes clean
                stmt.executeUpdate("CREATE TABLE IF NOT EXISTS Orders (orderId VARCHAR(20) PRIMARY KEY, userId VARCHAR(20), status VARCHAR(20))");
                stmt.executeUpdate("DELETE FROM Orders");

                Object[][] items = {
                        {"M01", "Chicken Biriyani", 120.0, 15}, {"M02", "Meals", 100.0, 20},
                        {"M03", "Chicken Fry", 100.0, 10}, {"M04", "Tea", 12.0, 50},
                        {"M05", "Black Tea", 10.0, 50}, {"M06", "Puffs", 20.0, 5},
                        {"M07", "Lime Juice", 15.0, 30}, {"M08", "Coffee", 15.0, 40},
                        {"M09", "Samosa", 15.0, 2}, {"M10", "Masala Dosa", 60.0, 10}
                };
                try (PreparedStatement ps = conn.prepareStatement(
                        "INSERT INTO MenuItems (itemId, name, price, stock) VALUES (?, ?, ?, ?)")) {
                    for (Object[] it : items) {
                        ps.setString(1, (String) it[0]);
                        ps.setString(2, (String) it[1]);
                        ps.setDouble(3, (Double) it[2]);
                        ps.setInt(4, (Integer) it[3]);
                        ps.executeUpdate();
                    }
                }
                loadMenu(m);
                say(msg, "✅ Default menu, stock, and order history reset successfully.", true);
            } catch (SQLException ex) {
                say(msg, "❌ Error loading menu: " + ex.getMessage(), false);
            }
        });

        p.onShow = () -> { if (loadMenu(m)) msg.setText(" "); };
        return p;
    }

