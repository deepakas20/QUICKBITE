            m.setRowCount(0);
            try (Connection c = db(); Statement s = c.createStatement();
                 ResultSet rs = s.executeQuery("SELECT * FROM Orders WHERE status = 'Pending'")) {
                while (rs.next()) m.addRow(new Object[]{rs.getString("orderId"), rs.getString("userId"), rs.getString("status")});
                info.setForeground(MUTED);
                info.setText(m.getRowCount() == 0 ? "✅ No pending orders. The kitchen is clear." : m.getRowCount() + " pending order(s)");
            } catch (SQLException ex) {
