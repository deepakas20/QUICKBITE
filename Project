    /* ===================== DASHBOARD SHELL ===================== */
    private static void openShell(String winTitle, String portal, Color accent, String[] names, Page[] pages) {
        JFrame frame = new JFrame(winTitle);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setMinimumSize(new Dimension(1000, 640));
        frame.setSize(1200, 720);
        frame.setLayout(new BorderLayout());

        JPanel sidebar = new JPanel();
        sidebar.setLayout(new BoxLayout(sidebar, BoxLayout.Y_AXIS));
        sidebar.setBackground(SIDEBAR);
        sidebar.setBorder(pad(26, 16, 22, 16));
        sidebar.setPreferredSize(new Dimension(260, 0));

        JLabel brand = label("🍔 QuickBite", B, 24, Color.WHITE);
        JLabel tag = label(portal, B, 13, blend(accent, 0.75));
        brand.setAlignmentX(Component.LEFT_ALIGNMENT);
        tag.setAlignmentX(Component.LEFT_ALIGNMENT);
        brand.setBorder(pad(0, 6, 0, 0));
        tag.setBorder(pad(0, 8, 0, 0));
        sidebar.add(brand);
        sidebar.add(Box.createVerticalStrut(2));
        sidebar.add(tag);
        sidebar.add(Box.createVerticalStrut(28));

        CardLayout cl = new CardLayout();
        JPanel content = new JPanel(cl);
        content.setBackground(BG);

        NavButton[] navs = new NavButton[names.length];
        IntConsumer[] select = new IntConsumer[1];
        select[0] = k -> {
            for (int j = 0; j < navs.length; j++) navs[j].setActive(j == k);
            cl.show(content, String.valueOf(k));
            pages[k].onShow.run();
        };

        for (int i = 0; i < names.length; i++) {
            final int idx = i;
            navs[i] = new NavButton(names[i], accent);
            navs[i].addActionListener(e -> select[0].accept(idx));
            sidebar.add(navs[i]);
            sidebar.add(Box.createVerticalStrut(6));

            JPanel holder = new JPanel(new BorderLayout());
            holder.setBackground(BG);
            holder.setBorder(pad(28, 32, 28, 32));
            holder.add(pages[i]);
            content.add(holder, String.valueOf(i));
        }

        sidebar.add(Box.createVerticalGlue());
        RoundedButton logout = new RoundedButton("🚪  Logout", RED, Color.WHITE);
        logout.setAlignmentX(Component.LEFT_ALIGNMENT);
        logout.setMaximumSize(new Dimension(Integer.MAX_VALUE, 46));
        logout.addActionListener(e -> { frame.dispose(); createLoginWindow(); });
        sidebar.add(logout);

        frame.add(sidebar, BorderLayout.WEST);
        frame.add(content, BorderLayout.CENTER);
        frame.setLocationRelativeTo(null);
        frame.setExtendedState(JFrame.MAXIMIZED_BOTH);
        select[0].accept(0);
        frame.setVisible(true);
    }

