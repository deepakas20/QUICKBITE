    private static Page studentOrder() {
        Page p = page("Pre-order Food", "Pick items, set quantity, and get your token.", null);

        List<CartLine> cart = new ArrayList<>();
        DefaultTableModel menuM = model("Item ID", "Item Name", "Price (Rs)", "Stock Available");
        JTable menuT = table(menuM, ORANGE);
        DefaultTableModel cartM = model("Item", "Qty", "Subtotal (Rs)");
        JTable cartT = table(cartM, ORANGE);

        JSpinner qty = new JSpinner(new SpinnerNumberModel(1, 1, 50, 1));
        qty.setFont(font(P, 14));
        RoundedButton add = new RoundedButton("＋  Add to cart", ORANGE, Color.WHITE);
        JLabel total = label("Total: Rs. 0.00", B, 20, TEXT);
        JTextField sid = input();
        RoundedButton remove = new RoundedButton("Remove selected", new Color(0x6B7280), Color.WHITE);
        RoundedButton place = new RoundedButton("Place order", ORANGE, Color.WHITE);

        Runnable rebuild = () -> {
            cartM.setRowCount(0);
            double sum = 0;
            for (CartLine l : cart) {
                cartM.addRow(new Object[]{l.name, l.qty, money(l.price * l.qty)});
                sum += l.price * l.qty;
            }
            total.setText("Total: Rs. " + money(sum));
        };

        // Left: menu
        Card left = new Card(new BorderLayout(0, 12));
        left.add(label("Choose from the menu", B, 16, TEXT), BorderLayout.NORTH);
        left.add(scroll(menuT), BorderLayout.CENTER);
        JPanel addBar = new JPanel(new FlowLayout(FlowLayout.LEFT, 12, 0));
        addBar.setOpaque(false);
        addBar.add(label("Quantity", B, 13, MUTED));
        addBar.add(qty);
        addBar.add(add);
        left.add(addBar, BorderLayout.SOUTH);

        // Right: cart
        Card right = new Card(new BorderLayout(0, 12));
        right.setPreferredSize(new Dimension(440, 0));
        JPanel top = new JPanel();
        top.setOpaque(false);
        top.setLayout(new BoxLayout(top, BoxLayout.Y_AXIS));
        JLabel cartTitle = label("Your cart", B, 16, TEXT);
        cartTitle.setAlignmentX(Component.LEFT_ALIGNMENT);
        cartTitle.setBorder(pad(0, 0, 12, 0));
        top.add(cartTitle);
        top.add(caption("Student ID"));
        top.add(sid);
        right.add(top, BorderLayout.NORTH);
        right.add(scroll(cartT), BorderLayout.CENTER);
        JPanel bottom = new JPanel(new BorderLayout(0, 12));
        bottom.setOpaque(false);
        bottom.add(total, BorderLayout.NORTH);
        JPanel btns = new JPanel(new GridLayout(1, 2, 10, 0));
        btns.setOpaque(false);
        btns.add(remove);
        btns.add(place);
        bottom.add(btns, BorderLayout.SOUTH);
        right.add(bottom, BorderLayout.SOUTH);

        JPanel body = new JPanel(new BorderLayout(18, 0));
        body.setOpaque(false);
        body.add(left, BorderLayout.CENTER);
        body.add(right, BorderLayout.EAST);
        p.add(body, BorderLayout.CENTER);

        add.addActionListener(e -> {
            int row = menuT.getSelectedRow();
            if (row < 0) { warn("Select an item from the menu first."); return; }
            int mr = menuT.convertRowIndexToModel(row);
            String id = (String) menuM.getValueAt(mr, 0);
            String name = (String) menuM.getValueAt(mr, 1);
            double price = Double.parseDouble((String) menuM.getValueAt(mr, 2));
            int stock;
            try { stock = Integer.parseInt((String) menuM.getValueAt(mr, 3)); } catch (NumberFormatException ex) { stock = 0; }
            if (stock <= 0) { warn("Sorry, " + name + " is out of stock."); return; }

            int q = (Integer) qty.getValue();
            CartLine existing = null;
            for (CartLine l : cart) if (l.id.equals(id)) existing = l;
            int inCart = existing == null ? 0 : existing.qty;
            if (q + inCart > stock) { warn("Not enough stock. Available: " + stock); return; }

            if (existing == null) cart.add(new CartLine(id, name, price, q));
            else existing.qty += q;
            rebuild.run();
            qty.setValue(1);
        });

        remove.addActionListener(e -> {
            int row = cartT.getSelectedRow();
            if (row < 0) { warn("Select a cart row to remove."); return; }
            cart.remove(cartT.convertRowIndexToModel(row));
            rebuild.run();
        });

        place.addActionListener(e -> {
            String studentId = sid.getText().trim();
            if (studentId.isEmpty()) { warn("Enter your registered Student ID."); return; }
            if (cart.isEmpty()) { warn("Your cart is empty."); return; }

            String oId = "TKN-" + (int) (Math.random() * 9000 + 1000);
            double sum = 0;
            for (CartLine l : cart) sum += l.price * l.qty;
            String items = cart.stream().map(l -> l.name + " x" + l.qty).collect(Collectors.joining(", "));

            try (Connection conn = db()) {
                conn.setAutoCommit(false);
                try {
                    try (PreparedStatement us = conn.prepareStatement(
                            "UPDATE MenuItems SET stock = stock - ? WHERE itemId = ? AND stock >= ?")) {
                        for (CartLine l : cart) {
                            us.setInt(1, l.qty);
                            us.setString(2, l.id);
                            us.setInt(3, l.qty);
                            if (us.executeUpdate() == 0) throw new SQLException("Not enough stock for " + l.name);
                        }
                    }
                    try (PreparedStatement os = conn.prepareStatement(
                            "INSERT INTO Orders (orderId, userId, status) VALUES (?, ?, 'Pending')")) {
                        os.setString(1, oId);
                        os.setString(2, studentId);
                        os.executeUpdate();
                    }
                    conn.commit();
                } catch (SQLException ex) {
                    conn.rollback();
                    throw ex;
                }
            } catch (SQLException ex) {
                JOptionPane.showMessageDialog(null, "Order failed. Check your Student ID and stock.",
                        "Error", JOptionPane.ERROR_MESSAGE);
                return;
            }

            JTextArea receipt = new JTextArea(
                    "  ==============================\n"
                            + "        QUICKBITE RECEIPT\n"
                            + "  ==============================\n"
                            + "  Token ID : " + oId + "\n"
                            + "  Items    : " + items + "\n"
                            + "  Total    : Rs. " + money(sum) + "\n"
                            + "  ==============================\n"
                            + "  Preparing... ready in about 40s");
            receipt.setEditable(false);
            receipt.setLineWrap(true);
            receipt.setWrapStyleWord(true);
            receipt.setFont(new Font("Consolas", B, 14));
            receipt.setBorder(pad(10, 10, 10, 10));
            receipt.setPreferredSize(new Dimension(420, 190));
            JOptionPane.showMessageDialog(null, receipt, "Order placed ✅", JOptionPane.PLAIN_MESSAGE);

            new OrderProcessor(oId, 40000).start();
            cart.clear();
            rebuild.run();
            loadMenu(menuM);
        });

        p.onShow = () -> loadMenu(menuM);
        return p;
    }

    private static Page studentTrack() {
        Page p = page("Track Token", "Check if your order is ready to collect.", null);
        Card card = new Card(null);
        card.setLayout(new BoxLayout(card, BoxLayout.Y_AXIS));
        card.setPreferredSize(new Dimension(460, 320));

        JTextField tokenF = input();
        RoundedButton btn = new RoundedButton("Track status", ORANGE, Color.WHITE);
        btn.setAlignmentX(Component.LEFT_ALIGNMENT);
        JLabel badge = new JLabel(" ");
        badge.setOpaque(true);
        badge.setFont(font(B, 15));
        badge.setForeground(Color.WHITE);
        badge.setBorder(pad(12, 18, 12, 18));
        badge.setAlignmentX(Component.LEFT_ALIGNMENT);
        badge.setVisible(false);

        card.add(caption("Token ID (e.g. TKN-1234)"));
        card.add(tokenF);
        card.add(Box.createVerticalStrut(20));
        card.add(btn);
        card.add(Box.createVerticalStrut(22));
        card.add(badge);

        btn.addActionListener(e -> {
            String tId = tokenF.getText().trim();
            if (tId.isEmpty()) return;
            try (Connection conn = db();
                 PreparedStatement ps = conn.prepareStatement("SELECT status FROM Orders WHERE orderId = ?")) {
                ps.setString(1, tId);
                ResultSet rs = ps.executeQuery();
                if (rs.next()) {
                    String st = rs.getString("status");
                    if (st.equals("Ready")) { badge.setBackground(GREEN); badge.setText("✅  " + tId + " is ready. Please collect your food."); }
                    else if (st.equals("Pending")) { badge.setBackground(AMBER); badge.setText("⏳  " + tId + " is being prepared..."); }
                    else { badge.setBackground(MUTED); badge.setText(tId + ": " + st); }
                } else {
                    badge.setBackground(RED);
                    badge.setText("❌  Token not found. Check the ID and try again.");
                }
            } catch (SQLException ex) {
                badge.setBackground(RED);
                badge.setText("❌  Couldn't reach the database.");
            }
            badge.setVisible(true);
            card.revalidate();
            card.repaint();
        });

        JPanel wrap = new JPanel(new FlowLayout(FlowLayout.LEFT, 0, 0));
        wrap.setOpaque(false);
        wrap.add(card);
        p.add(wrap, BorderLayout.CENTER);
        return p;
    }

