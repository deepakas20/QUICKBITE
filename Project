    static boolean loadMenu(DefaultTableModel m) {
        m.setRowCount(0);
        try (Connection c = db(); Statement s = c.createStatement(); ResultSet rs = s.executeQuery("SELECT * FROM MenuItems")) {
            while (rs.next()) {
                int st = rs.getInt("stock");
                m.addRow(new Object[]{rs.getString("itemId"), rs.getString("name"),
                        money(rs.getDouble("price")), st > 0 ? String.valueOf(st) : "OUT OF STOCK"});
            }
            return true;
        } catch (SQLException e) {
            return false;
        }
    }

