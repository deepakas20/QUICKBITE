        Page p = page("Setup Menu & Stock", "Load the default menu and reset inventory.", null);

        Card action = new Card(new BorderLayout(20, 0));
        action.add(new JLabel("<html><div style='font-family:Segoe UI'><b style='font-size:14px'>Load default menu</b><br>"
