/* ===================== BACKGROUND KITCHEN THREAD ===================== */
class OrderProcessor extends Thread {
    private final String orderId;
    private final int delayTime;

    public OrderProcessor(String orderId, int delayTime) {
        this.orderId = orderId;
        this.delayTime = delayTime;
    }

    @Override
    public void run() {
        try {
            Thread.sleep(delayTime);
            try (Connection conn = Main.db();
                 PreparedStatement pstmt = conn.prepareStatement("UPDATE Orders SET status = 'Ready' WHERE orderId = ?")) {
                pstmt.setString(1, orderId);
                pstmt.executeUpdate();
            }
            SwingUtilities.invokeLater(() -> JOptionPane.showMessageDialog(null,
                    "🔔 DING! Token " + orderId + " is READY!\nPlease collect your food.",
                    "Order Ready", JOptionPane.INFORMATION_MESSAGE));
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}

