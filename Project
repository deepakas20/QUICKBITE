    static Color blend(Color c, double t) {
        int r = (int) (c.getRed() + (255 - c.getRed()) * (1 - t));
        int g = (int) (c.getGreen() + (255 - c.getGreen()) * (1 - t));
        int b = (int) (c.getBlue() + (255 - c.getBlue()) * (1 - t));
        return new Color(r, g, b);
    }

