            List<Integer> vals = new ArrayList<>();
            try (Connection c = db(); Statement s = c.createStatement();
                 ResultSet rs = s.executeQuery("SELECT name, stock FROM MenuItems")) {
                while (rs.next()) {
                    names.add(rs.getString("name"));
                    vals.add(rs.getInt("stock"));
                }
            } catch (SQLException ex) {
                // leave chart empty
            }
            chart.setData(names, vals);
        };
        return p;
